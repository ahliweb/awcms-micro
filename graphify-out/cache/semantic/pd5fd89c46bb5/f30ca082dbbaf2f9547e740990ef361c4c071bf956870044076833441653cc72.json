{"nodes": [{"id": "docs_awcms_micro_deploy_coolify", "label": "Deploy Coolify", "file_type": "document", "source_file": "docs/awcms-micro/deploy-coolify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_deploy_coolify_two_patterns", "label": "Two Coolify deploy patterns (build-from-repo vs pull-image)", "file_type": "concept", "source_file": "docs/awcms-micro/deploy-coolify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_deploy_coolify_healthcheck_gotcha", "label": "Coolify curl-not-found healthcheck gotcha", "file_type": "rationale", "source_file": "docs/awcms-micro/deploy-coolify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dockerfile.production has no curl/wget, so Coolify's own HTTP health check (docker exec curl) fails and rolls back a healthy deploy; fix is disabling Coolify's health_check_enabled and relying on the image's own Docker HEALTHCHECK."}, {"id": "docs_awcms_micro_deploy_coolify_port_publish_gotcha", "label": "Coolify port publish without Traefik gotcha (--ip pin workaround)", "file_type": "rationale", "source_file": "docs/awcms-micro/deploy-coolify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ports_mappings rejects IP prefixes and custom_docker_run_options silently drops -p; solution is pinning the container to a static bridge IP via --ip and pointing an external reverse proxy at it directly, avoiding host port publish entirely."}], "edges": [{"source": "docs_awcms_micro_database_capacity_runbook_capacity_config", "target": "docs_awcms_micro_deploy_coolify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/deploy-coolify.md", "source_location": null, "weight": 1.0}, {"s