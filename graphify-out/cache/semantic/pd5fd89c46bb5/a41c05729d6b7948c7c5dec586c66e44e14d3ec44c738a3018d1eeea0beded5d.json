{"nodes": [{"id": "docs_awcms_micro_database_pooling", "label": "Database Connection Pooling and Backpressure", "file_type": "document", "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_database_pooling_work_class_gate", "label": "Work-class concurrency gate (work-class.ts)", "file_type": "code", "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory per-process semaphore with five fixed work classes and small non-tunable concurrency caps below DATABASE_POOL_MAX, prioritized per doc 16's priority table; bounded FIFO queue (Issue #743) rejects immediately once queue depth hits max*multiplier to avoid cascading timeout chains."}, {"id": "docs_awcms_micro_database_pooling_circuit_breaker", "label": "Database circuit breaker (circuit-breaker.ts)", "file_type": "code", "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3-state (closed/open/half_open) breaker, pure function of an injected now, shared application-wide singleton so accumulated failures across requests/tenants trigger one fail-fast decision."}, {"id": "docs_awcms_micro_database_pooling_withtenant", "label": "withTenant integration chokepoint", "file_type": "code", "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_database_pooling_promise_all_tx_bug", "label": "Concurrent Promise.all on one tx corrupts transaction", "file_type": "rationale", "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firing multiple queries concurrently on the same reserved Postgres connection desyncs it, leaving it idle in transaction forever (COMMIT never sent); rule is to always await tx queries sequentially inside withTenant/sql.begin."}], "edges": [{"source": "docs_awcms_micro_database_pooling", "target": "docs_awcms_micro_database_pooling_work_class_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_database_pooling", "target": "docs_awcms_micro_database_pooling_circuit_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_database_pooling", "target": "docs_awcms_micro_database_pooling_withtenant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_database_pooling_withtenant", "target": "docs_awcms_micro_database_pooling_work_class_gate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_database_pooling_withtenant", "target": "docs_awcms_micro_database_pooling_circuit_breaker", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_database_pooling", "target": "docs_awcms_micro_database_pooling_promise_all_tx_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/database-pooling.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_d