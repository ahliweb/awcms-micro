{"nodes": [{"id": "claude_skills_awcms_micro_browser_test_skill", "label": "awcms-micro-browser-test Skill", "file_type": "document", "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_e2e_bun_playwright_runtime", "label": "bun --bun playwright test Runtime Enforcement", "file_type": "rationale", "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@playwright/test's binary has a #!/usr/bin/env node shebang; without --bun, bun run test:e2e silently runs the test runner process under real Node.js (verified via process.versions), violating the Bun-only backend rule (AGENTS.md #14) undetected unless checked directly."}, {"id": "concept_e2e_seed_retry_conflict_bug", "label": "Seed ON CONFLICT DO NOTHING Retry Bug (#272 fix)", "file_type": "rationale", "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playwright retry spawns a new worker so beforeAll reruns; ON CONFLICT DO NOTHING seeding a single-use token collides with the already-consumed token from the prior attempt and fails despite a docstring claiming retry-safety. Fixed with ON CONFLICT DO UPDATE SET consumed_at=NULL to truly re-arm."}, {"id": "concept_entrance_animation_axe_contrast_bug", "label": "Opacity-Fade Entrance vs axe color-contrast Scan Bug (#314/#315)", "file_type": "rationale", "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "axe scans /admin immediately after waitForURL, so an opacity:0->1 entrance animation gets caught mid-fade and fails color-contrast(serious); fix is CSS (transform-only entrance, opacity stays 1), not adding waitForTimeout which would hide real contrast regressions."}], "edges": [{"source": "claude_skills_awcms_micro_browser_test_skill", "target": "concept_e2e_bun_playwright_runtime", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_browser_test_skill", "target": "concept_e2e_seed_retry_conflict_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_browser_test_skill", "target": "concept_entrance_animation_axe_contrast_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_browser_test_skill", "target": "changeset_website_platform_293_296_evidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_browser_test_skill", "target": "changeset_website_platform_evidence_296_295_293_294", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "concept_entrance_animation_axe_contrast_bug", "target": "concept_motion_token_foundation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/awcms-micro-browser-test/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_browser_test_skill", "target":