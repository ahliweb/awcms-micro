{"nodes": [{"id": "docs_awcms_micro_news_portal_social_sharing", "label": "Social Sharing (Manual)", "file_type": "document", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_sharing_manual_vs_auto_distinction", "label": "Manual share vs auto posting distinction", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual share is reader-initiated with no credentials/API calls/persisted data, independent of the tenant-driven auto-posting system; no code dependency between social-share-links.ts and the social-publishing module."}, {"id": "src_modules_blog_content_domain_social_share_links_rendersocialsharebuttonshtml", "label": "renderSocialShareButtonsHtml", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_sharing_instagram_no_share_url", "label": "Instagram has no official share-intent URL", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No official web-share URL exists for Instagram unlike WhatsApp/Telegram/Facebook/LinkedIn/X, so only native share sheet or copy-link are offered; test explicitly asserts no instagram.com string appears in output."}, {"id": "docs_awcms_micro_news_portal_social_sharing_canonical_url_structural_guarantee", "label": "Canonical URL structural no-leak guarantee", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Share links are built only from server-resolved canonicalUrl (never request.url/Astro.url raw), so querystring/tracking/session params structurally cannot leak \u2014 guaranteed by construction, not by a filter that could forget to filter something."}, {"id": "docs_awcms_micro_news_portal_social_sharing_static_script_csp_rationale", "label": "Static same-origin script file avoids Astro CSP hashing gap", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "news-share.js is loaded via <script src> not inline, because news pages render through .ts API routes (not .astro components) and never pass through Astro's CSP hashing pipeline \u2014 an inline script here would risk real browser CSP blocking without headless-Chrome tooling to detect it."}, {"id": "src_pages_news_slug_ts", "label": "src/pages/news/[slug].ts", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_awcms_micro_news_portal_social_sharing", "target": "docs_awcms_micro_news_portal_social_sharing_manual_vs_auto_distinction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_news_portal_social_sharing_manual_vs_auto_distinction", "target": "docs_awcms_micro_news_portal_social_publishing_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/news-portal/social-sharing.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_news_portal_social_sharing", "target": 