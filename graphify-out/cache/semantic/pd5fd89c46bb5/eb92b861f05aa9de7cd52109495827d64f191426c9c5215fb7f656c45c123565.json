{"nodes": [{"id": "changelog_v1_0_0", "label": "AWCMS-Micro v1.0.0 release", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_comments_module_admission", "label": "comments module admission (ADR-0032, Issue #271)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0032_comments_module", "label": "ADR-0032: comments module admission", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admits comments as a tenant-scoped, moderation-first commenting system over published/public commentable resources; introduces the commentableResources descriptor-list contribution seam mirroring searchSources so content modules declare pure-data resources without comments depending on them."}, {"id": "changelog_newsletter_module_admission", "label": "newsletter module admission (ADR-0033, Issue #272)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0033_newsletter_module", "label": "ADR-0033: newsletter module admission", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admits newsletter as a tenant-scoped, consent-first, anti-enumeration subscription-list system; reuses the descriptor-list contribution seam pattern (newsletterContentSources) mirroring commentableResources/searchSources, keeping newsletter as a consumer/aggregator leaf that nothing depends on."}, {"id": "docs_adr_0026_media_library_admission", "label": "ADR-0026: media_library admission and ownership", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reverses ownership of media reconciliation job/table to media_library (previously news_portal); fixes a gap where enabling content-consumer modules could implicitly disable media registry for a tenant since media_library is a non-protected System Foundation module."}, {"id": "docs_adr_0028_seo_distribution_admission", "label": "ADR-0028: seo_distribution module admission", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admits seo_distribution as an Official Optional Module consuming seo_facts (provided by content modules) to avoid ad-hoc per-route SEO metadata derivation drift; defines threat model for host-header poisoning, JSON-LD injection, cache poisoning, sitemap amplification, and unpublished-content leakage."}, {"id": "docs_adr_0029_theming_admission", "label": "ADR-0029: theming module admission", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admits theming as an Official Optional Module where themes are trusted build-time code (not DB/uploads); design-token values validated with REJECT-not-sanitize grammar to prevent CSS/URL injection while serving tokens via same-origin CSS to preserve CSP style-src 'self'."}, {"id": "docs_adr_0031_site_search_admission", "label": "ADR-0031: site_search module admission", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admits site_search as a DAG-safe inward module reading content sources via the searchSources descriptor-list seam rather than a capability provider, avoiding capability_provider_conflict; the index is a projection of public content only, never an authorization source."}, {"id": "seo_facts_port_contract", "label": "seo_facts contribution contract (SeoFactsSource port)", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "descriptor_seam_commentable_resources", "label": "commentableResources descriptor-list seam", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure-data descriptor-list contribution pattern letting content modules (e.g. blog_content) declare reviewed resources that a consumer module (comments) reads via listModules() and re-validates before any SQL, avoiding direct cross-module dependency."}, {"id": "descriptor_seam_newsletter_content_sources", "label": "newsletterContentSources descriptor-list seam", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descriptor-list contribution seam mirroring commentableResources/searchSources for newsletter content sources."}, {"id": "descriptor_seam_search_sources", "label": "searchSources descriptor-list seam", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declarative table/column mapping + publication filter descriptors that content modules provide and site_search reads via listModules(), avoiding a capability-provider model that would trip capability_provider_conflict with multiple providers."}, {"id": "redis_foundation_optional", "label": "Optional Redis foundation (RedisClient, cache-aside)", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": 