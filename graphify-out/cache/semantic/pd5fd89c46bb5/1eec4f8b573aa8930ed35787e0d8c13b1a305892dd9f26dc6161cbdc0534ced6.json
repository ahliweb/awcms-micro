{"nodes": [{"id": "claude_skills_awcms_micro_blog_content_skill", "label": "awcms-micro-blog-content Skill", "file_type": "document", "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_blog_content_module", "label": "blog_content Module (Epic #536)", "file_type": "concept", "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First domain module registered directly in the base repo (not a downstream app); epic #536 (#537-#543) fully complete, status active."}, {"id": "concept_news_route_reuse", "label": "/news Route Reuses /blog Public Query Layer (Issue #560)", "file_type": "concept", "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/news adds only a tenant-resolution layer (host-based via withNewsTenant) and basePath link building on top of the exact same public-blog-directory/public-page-rendering/seo-rendering services /blog/{tenantCode} uses \u2014 deliberately not a rewrite."}, {"id": "concept_module_boundary_capability_port", "label": "Cross-Module Capability Port Boundary (Issue #681, ADR-0011)", "file_type": "concept", "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "application/domain code in blog_content is forbidden from importing news_portal's application/domain tree directly; capabilities like R2 media validation are received via an injected NewsMediaPort parameter instead, enforced by tests/unit/module-boundary.test.ts."}, {"id": "concept_public_content_css_only", "label": "CSP-Only Public Styling via public-content.css", "file_type": "rationale", "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "public-page-rendering.ts emits raw HTML strings from .ts route handlers, invisible to Astro's CSP style-hasher, so default-src 'self' blocks inline <style>/style= \u2014 the only CSP-legal path is the external same-origin public/css/public-content.css stylesheet."}], "edges": [{"source": "claude_skills_awcms_micro_blog_content_skill", "target": "concept_blog_content_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_blog_content_skill", "target": "concept_news_route_reuse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_blog_content_skill", "target": "concept_module_boundary_capability_port", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_awcms_micro_blog_content_skill", "target": "concept_public_content_css_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "concept_public_content_css_only", "target": "changeset_ui_overhaul_phase2", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "concept_news_route_reuse", "target": "concept_module_boundary_capability_port", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/awcms-micro-blog-content/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}