{"nodes": [{"id": "docs_awcms_micro_data_lifecycle", "label": "Data Lifecycle \u2014 operational and compliance guide", "file_type": "document", "source_file": "docs/awcms-micro/data-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_data_lifecycle_registry_descriptor", "label": "HighVolumeTableDescriptor registry", "file_type": "concept", "source_file": "docs/awcms-micro/data-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static code contract each owning module declares for its high-volume tables; the lifecycle engine operates only through this contract, never writing directly to another module's schema (no shared-table write, ADR-0013 \u00a76)."}, {"id": "docs_awcms_micro_data_lifecycle_legal_hold", "label": "Legal hold mechanism (data_lifecycle_legal_holds)", "file_type": "concept", "source_file": "docs/awcms-micro/data-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active hold makes all eligible rows report 'held' unconditionally before any archive/purge branch, overriding any retentionDaysOverride; create/release are separate permissions to prevent unilateral release."}, {"id": "docs_awcms_micro_data_lifecycle_cursor_precision", "label": "Cursor boundary safety margin (microsecond vs millisecond)", "file_type": "rationale", "source_file": "docs/awcms-micro/data-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz has microsecond precision but JS Date only milliseconds; a 1ms CURSOR_BOUNDARY_SAFETY_MARGIN_MS pad prevents boundary rows from failing comparison against their own truncated value, fixing lost-row purge and endless archive-resume bugs."}, {"id": "docs_awcms_micro_data_lifecycle_local_archive_adapter", "l