{"nodes": [{"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist", "label": "Social Publishing Security Checklist", "file_type": "document", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_modules_social_publishing_domain_social_account_validation_lookslikerawsecrettoken", "label": "looksLikeRawSecretToken", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-effort, defense-in-depth strip-and-recheck loop (MAX_REFERENCE_PREFIX_STRIPS=5) rejecting values shaped like real bearer tokens (JWT, Meta EAA..., Google ya29./1//, GitHub gh[a-z]_..., Telegram bot token, 64+ char base64/hex blobs); after two prior bypassable rounds (PR #731), round 3 fixed by re-anchoring prefix-stripping to the remaining string each iteration rather than the whole original string."}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_revalidation_bug", "label": "Re-validating resolved secret value bug (PR #737, LinkedIn)", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "resolveLinkedInSecretReference re-validated the resolved credential (not the reference) against looksLikeRawSecretToken, causing every valid 150-1000+ char LinkedIn token to be rejected as 'unresolvable'; fixed by only validating the pre-resolution reference string, following resolveMetaTokenReference as the clean reference implementation."}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_redact_truncate_order_bug", "label": "Redact-before-truncate ordering bug (PR #737, LinkedIn)", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "linkedin-provider-adapter.ts called redact(truncate(message,500), token) \u2014 reversed order let a token fragment straddling the truncation boundary escape redact()'s exact-match .split(token); fixed to truncate(redact(message, token), 500), redact must always run on the full string first."}, {"id": "src_modules_social_publishing_infrastructure_linkedin_provider_adapter_resolvelinkedinsecretreference", "label": "resolveLinkedInSecretReference", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_modules_social_publishing_domain_meta_token_resolveMetaTokenReference", "label": "resolveMetaTokenReference", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_telegram_markdown_escaping", "label": "Telegram MarkdownV2 single-pass escaping pattern", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "escapeTelegramMarkdownV2 uses one single regex pass and includes backslash itself in the escaped character class, avoiding a bug class where original backslashes 'lock' with newly-inserted escape backslashes and let following characters slip through unescaped."}, {"id": "src_modules_social_publishing_domain_telegram_message_formatting_escapetelegrammarkdownv2", "label": "escapeTelegramMarkdownV2", "file_type": "code", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_scraping_ban", "label": "Ban on scraping/browser automation for social platforms", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scraping/browser automation violates platform ToS, breaks silently on UI changes, and cannot be audited as official API action; unsupported capabilities must be documented as platform limitations instead."}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_incident_response_token_leak", "label": "Incident response \u2014 leaked social token", "file_type": "concept", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_security_checklist_incident_response_unauthorized_post", "label": "Incident response \u2014 unauthorized/unintended external post", "file_type": "concept", "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_awcms_micro_news_portal_social_publishing_security_checklist", "target": "src_modules_social_publishing_domain_social_account_validation_lookslikerawsecrettoken", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/news-portal/social-publishing-security-checklist.md", "sour