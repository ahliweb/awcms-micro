{"nodes": [{"id": "docs_awcms_micro_20_threat_model_security_architecture_doc", "label": "Threat Model & Security Architecture (Doc 20)", "file_type": "document", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_stride", "label": "STRIDE threat model", "file_type": "concept", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spoofing/Tampering/Repudiation/Information-disclosure/DoS/Elevation mapped to base mitigations; trust-boundary principle: all untrusted-zone input validated, tenant/identity always from auth middleware, never raw public headers."}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_abac_default_deny", "label": "ABAC default-deny (deny-overrides-allow, ADR-0004)", "file_type": "concept", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "evaluateAccess() returns default_deny on empty grant set, self_approval_deny for high-risk approver==requester; gated by checkAbacDefaultDeny in security-readiness.ts. Cross-module deny-biased evaluator \u2014 ownership ALLOW overrides are module-specific business logic composed on top, never new cross-module primitives."}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_rls_force", "label": "RLS ENABLE+FORCE tenant isolation (ADR-0003)", "file_type": "concept", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS FORCE on tenant-scoped tables is the real security boundary; awcms_micro_app is non-superuser/non-BYPASSRLS. Tenant context via withTenant()/SET LOCAL app.current_tenant_id; fail-closed zero-UUID GUC sentinel when unset."}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_compliance_matrix", "label": "OWASP/ASVS/ISO 27001 compliance matrix (Issue #437)", "file_type": "document", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps OWASP Top 10 / ASVS L1-L2 / ISO 27001 Annex A controls to concrete in-repo evidence (file/function/query), each row carrying live-verified proof. Security response headers and login rate-limiting were real gaps found and closed by Issue #437."}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_secret_redaction", "label": "Secret redaction (_shared/redaction.ts)", "file_type": "concept", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REDACTION_KEYS (key-based) plus findSecretShapedValues/redactSecretsInText (value-shape: JWT, PEM, AWS/GitHub/OpenAI/Slack/Stripe/Google vendor prefixes) \u2014 deliberately no generic entropy heuristic because UUIDs/content-hashes/idempotency-keys would false-positive constantly. Applied by logger and audit trail before write."}, {"id": "docs_awcms_micro_20_threat_model_security_architecture_circuit_breaker", "label": "Per-provider circuit breaker (outbox, ADR-0006)", "file_type": "concept", "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider calls always outside DB transaction; circuit breaker per-provider (SSO keyed per tenant+providerKey after cross-tenant leak fix) only trips on genuine transport failure (5xx/network/timeout), never on valid 4xx \u2014 a valid-4xx breaker was an unauthenticated cross-tenant lockout DoS (PR #596). Provider outage never locks break-glass local login."}], "edges": [{"source": "docs_awcms_micro_20_threat_model_security_architecture_doc", "target": "docs_awcms_micro_20_threat_model_security_architecture_stride", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_20_threat_model_security_architecture_doc", "target": "docs_awcms_micro_20_threat_model_security_architecture_abac_default_deny", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_20_threat_model_security_architecture_doc", "target": "docs_awcms_micro_20_threat_model_security_architecture_rls_force", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_20_threat_model_security_architecture_doc", "target": "docs_awcms_micro_20_threat_model_security_architecture_compliance_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_20_threat_model_security_architecture_doc", "target": "docs_awcms_micro_20_threat_model_security_architecture_secret_redaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/20_threat_model_security_architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_20_threat_model_security_arc