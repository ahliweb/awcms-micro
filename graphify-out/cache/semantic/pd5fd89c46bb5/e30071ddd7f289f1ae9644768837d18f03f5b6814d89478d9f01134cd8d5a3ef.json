{"nodes": [{"id": "docs_awcms_micro_16_backend_data_access_integration", "label": "Backend Data Access dan Integrasi Database", "file_type": "document", "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "awcms_micro_concept_transactional_outbox", "label": "Concept: Transactional Outbox Pattern", "file_type": "concept", "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain events, messages (email/newsletter), and sync data are written in the same DB transaction as the business mutation, then dispatched by a separate worker outside the transaction, guaranteeing consistency without calling external providers inside a DB transaction."}, {"id": "awcms_micro_concept_claim_lease_dispatcher", "label": "Concept: Claim-Lease Dispatcher (CLAIM/SEND/FINALIZE)", "file_type": "concept", "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outbox rows are claimed via UPDATE...FOR UPDATE SKIP LOCKED into a transient 'sending' state, sent to the provider outside any transaction, then finalized to sent/retry_wait/failed in a short transaction, safely handling concurrent dispatcher runs without duplication."}, {"id": "awcms_micro_concept_domain_event_runtime_multi_consumer", "label": "Concept: Generic Multi-Consumer Domain Event Outbox", "file_type": "concept", "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike single-purpose outboxes (sync_storage/email/social_publishing), domain_event_runtime fans out one event to many registered consumers with explicit per-aggregate ordering; same-process DB-only consumers combine claim+execute+finalize in one transaction for crash-safe recovery."}, {"id": "awcms_micro_concept_work_class_pooling", "label": "Concept: Work-Class Connection Pooling & Backpressure", "file_type": "concept", "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connections are gated by work class (critical_transaction/interactive/reporting/background_sync/maintenance) so operational transactions stay prioritized; saturation returns 503 DATABASE_BUSY and triggers database.pool.saturated event."}], "edges": [{"source": "awcms_micro_event_sales_transaction_posted", "target": "awcms_micro_concept_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_concept_claim_lease_dispatcher", "target": "awcms_micro_concept_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_concept_domain_event_runtime_multi_consumer", "target": "awcms_micro_concept_claim_lease_dispatcher", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_module_domain_event_runtime", "target": "awcms_micro_concept_domain_event_runtime_multi_consumer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_module_email", "target": "awcms_micro_concept_claim_lease_dispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_module_sync_storage", "target": "awcms_micro_concept_claim_lease_dispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_concept_multi_tenant_rls", "target": "awcms_micro_concept_work_class_pooling", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_concept_idempotency", "target": "awcms_micro_table_idempotency_keys", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "awcms_micro_concept_soft_delete", "target": "awcms_micro_table_audit_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_awcms_micro_16_backend_data_access_integration", "target": "awcms_micro_concept_bun_only_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/awcms-micro/16_backend_data_access_integration.md", "source_location": null, "weight": 1.0}], "hyperedges": []}