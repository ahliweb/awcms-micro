{"nodes": [{"id": "docs_awcms_micro_news_portal_social_publishing_architecture", "label": "Social Publishing (Auto Posting) Architecture", "file_type": "document", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_dual_flag_gate", "label": "Dual-flag deployment gate (SOCIAL_PUBLISHING_ENABLED + PROFILE)", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately not reusing NEWS_PORTAL_ENABLED/_PROFILE because a tenant can be full-online for news_portal without ever wanting social auto-posting, and vice versa; mirrors AUTH_ONLINE_SECURITY_ENABLED/_PROFILE pattern."}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_token_reference", "label": "token_reference indirection pattern", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "token_reference is an opaque pointer to external secret storage, never real credential; never re-selected except by two narrow internal functions (dispatch, verification); disconnect nulls it out rather than flipping status."}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_provider_adapter_registry", "label": "Pluggable provider adapter registry (4 adapters)", "file_type": "concept", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_outbox_pattern", "label": "Outbox job-creation-in-transaction pattern (ADR-0006)", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createSocialPublishJobsForArticle only INSERTs job rows inside the same transaction as post publish transition \u2014 not a violation of ADR-0006, which forbids provider calls inside a transaction, not outbox row writes. Real provider calls happen only in dispatchSocialPublishQueue's 3-phase CLAIM/CALL/FINALIZE, identical pattern to sync-storage/application/object-dispatch.ts."}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_retry_backoff", "label": "Job retry/backoff lifecycle (evaluateSocialPublishRetry)", "file_type": "concept", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formula 2^attemptCount minutes capped at SOCIAL_PUBLISH_MAX_RETRY_DELAY_MINUTES=240, same formula as sync-storage's evaluateObjectRetry but not reused directly because constants differ per-row vs per-module."}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_account_verification", "label": "Account verification endpoint (informational, not hard gate)", "file_type": "concept", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_awcms_micro_news_portal_social_publishing_architecture_r2_image_defense_in_depth", "label": "R2-only image defense-in-depth per adapter", "file_type": "rationale", "source_file": "docs/awcms-micro/news-portal/social-publishing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "