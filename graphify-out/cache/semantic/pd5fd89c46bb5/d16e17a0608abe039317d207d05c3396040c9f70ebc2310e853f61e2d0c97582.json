{"nodes": [{"id": "claude_agents_awcms_micro_coder", "label": "awcms-micro-coder Agent", "file_type": "document", "source_file": ".claude/agents/awcms-micro-coder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_awcms_micro_coder_role", "label": "awcms-micro-coder: end-to-end issue implementation agent", "file_type": "rationale", "source_file": ".claude/agents/awcms-micro-coder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must not delegate to other agents (including itself) \u2014 works alone through Read/Edit/Write/Bash until done in one session; must not background long-running validation commands and wait for its own notification, since background notifications only reach the orchestrator, never the agent itself."}, {"id": "concept_withtenant_promise_all_anti_pattern", "label": "withTenant Promise.all Anti-Pattern", "file_type": "rationale", "source_file": ".claude/agents/awcms-micro-coder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tx is a single connection; running Promise.all across several queries on it desyncs the connection, causing 'idle in transaction', pool exhaustion, and 503 DATABASE_BUSY \u2014 must await sequentially or use a for loop instead. Root cause of prod incident PR #323/#324."}], "edges": [{"source": "claude_agents_awcms_micro_coder", "target": "claude_skills_awcms_micro_abac_guard_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/awcms-micro-coder.md", "source_location": null, "weight": 1.0}, {"source": "claude_agents_awcms_micro_coder", "target": "claude_skills_awcms_micro_audit_log_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/awcms-micro-coder.md", "source_location": null, "wei