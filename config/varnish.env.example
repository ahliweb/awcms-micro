# Optional Varnish edge-cache profile for AWCMS-Micro (Issue #353, ADR-0037).
#
# The edge cache is disabled by default. Copy this file to the ignored
# `.env.varnish` only when the optional cache layer is intentionally enabled:
#
#   cp config/varnish.env.example .env.varnish
#
# Never commit a real EDGE_CACHE_PURGE_TOKEN.

EDGE_CACHE_ENABLED=true

# Baseline surrogate TTL. This is the freshness contract for public pages:
# an edit is visible to anonymous readers within this many seconds even
# when nothing purges the cache explicitly.
EDGE_CACHE_DEFAULT_TTL_SECONDS=60

# TTL used while the automatic escalation is active — i.e. only while the
# application has measured real database pressure. Must be >= the baseline;
# a smaller value is clamped up rather than honoured.
EDGE_CACHE_BOOST_TTL_SECONDS=300

# Browser-facing max-age. 0 keeps readers revalidating (so a purge is
# effective immediately for them) while the shared cache absorbs the load.
# Raise it only for content whose staleness in a single browser is harmless.
EDGE_CACHE_BROWSER_TTL_SECONDS=0

# Serving-while-refreshing and serving-while-broken. The second value is
# the one that turns a database outage into stale pages instead of 503s.
EDGE_CACHE_STALE_WHILE_REVALIDATE_SECONDS=60
EDGE_CACHE_STALE_IF_ERROR_SECONDS=600

# Automatic escalation. `true` lets the application raise the TTL by itself
# when foreground work-class utilization reaches the threshold below, or
# when the database circuit breaker is not closed.
EDGE_CACHE_AUTO_ESCALATION=true
EDGE_CACHE_PRESSURE_THRESHOLD_PERCENT=70

# Explicit invalidation. The Compose overlay points this at the internal
# `varnish` service; the cache accepts a BAN only from a private network
# AND with this exact token. Leaving the token empty disables invalidation
# entirely — staleness is then bounded only by the TTLs above.
EDGE_CACHE_PURGE_URL=http://varnish:8080
EDGE_CACHE_PURGE_TOKEN=change-me-with-a-long-random-secret

# Compose overlay only — Varnish's in-memory storage size.
VARNISH_SIZE=256M
