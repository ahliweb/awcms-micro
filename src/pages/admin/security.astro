---
/**
 * Full-online auth security admin UI (Issue #592, epic #587-#593) — the
 * #587 deployment gate's status and, when active, the #591 tenant auth
 * policy + SSO provider admin CRUD. The page adds no enforcement of its
 * own: every mutation goes through the real `/api/v1/identity/sso/**`
 * endpoints and their ABAC + break-glass + audit logic.
 *
 * This file is markup. Its three other concerns live in the module's
 * presentation layer (ADR-0038), where `tsc`/`bun test` reach them and the
 * gates, SSR read and break-glass UX are documented (Issue #372):
 *   - gates, permissions, SSR read -> `presentation/security-page-data.ts`
 *   - browser behaviour            -> `presentation/security-admin-client.ts`
 *   - styling                      -> `presentation/security-page.css`
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import ActionBanner from "../../components/ui/ActionBanner.astro";
import CheckboxField from "../../components/ui/CheckboxField.astro";
import CheckboxGroup from "../../components/ui/CheckboxGroup.astro";
import ClientJsonData from "../../components/ui/ClientJsonData.astro";
import DataTable from "../../components/ui/DataTable.astro";
import FieldHint from "../../components/ui/FieldHint.astro";
import LoadErrorNotice from "../../components/ui/LoadErrorNotice.astro";
import StateNotice from "../../components/ui/StateNotice.astro";
import { createTranslator } from "../../lib/i18n/translate";
import TextField from "../../components/ui/TextField.astro";
import {
  buildBreakGlassItems,
  buildSecurityClientStrings,
  buildSecurityStatusRows,
  loadSecurityPageModel
} from "../../modules/identity-access/presentation/security-page-data";
import "../../modules/identity-access/presentation/security-page.css";

const context = Astro.locals.ssrContext;

if (!context) {
  throw new Error(
    "admin/security.astro rendered without Astro.locals.ssrContext — src/middleware.ts should have redirected to /login before this page ever runs."
  );
}

const t = await createTranslator(Astro.locals.locale);
const clientStrings = buildSecurityClientStrings(t);

const {
  statusSummary,
  canReadPolicy: CAN_READ_POLICY,
  canUpdatePolicy: CAN_UPDATE_POLICY,
  canReadProviders: CAN_READ_PROVIDERS,
  canCreateProviders: CAN_CREATE_PROVIDERS,
  canUpdateProviders: CAN_UPDATE_PROVIDERS,
  canDeleteProviders: CAN_DELETE_PROVIDERS,
  canReadUsers: CAN_READ_USERS,
  canReadAnything: CAN_READ_ANYTHING,
  policy,
  providers,
  breakGlassCandidates,
  loadError
} = await loadSecurityPageModel(context, {
  correlationId: Astro.locals.correlationId
});

const displayNameLabel = t("admin.security.display_name_label");
const issuerUrlLabel = t("admin.security.issuer_url_label");
const clientIdLabel = t("admin.security.client_id_label");
const clientSecretLabel = t("admin.security.client_secret_label");
const clientSecretEnvVarLabel = t("admin.security.client_secret_env_var_label");
const scopesLabel = t("admin.security.scopes_label");
const emailDomainsLabel = t("admin.security.allowed_email_domains_label");
const providerEnabledLabel = t("admin.security.enabled_label");
const clientSecretHint = t("admin.security.client_secret_hint");
const ssoRequiredHint = t("admin.security.sso_required_hint");
const emailDomainsHint = t("admin.security.allowed_email_domains_hint");
const breakGlassManualHint = t("admin.security.break_glass_manual_hint");
const clientSecretEnvVarHint = t("admin.security.client_secret_env_var_hint");
const statusRows = buildSecurityStatusRows(t, statusSummary);
const gateStatus = statusSummary.gateActive ? "active" : "inactive";
const showDenied = statusSummary.gateActive && !CAN_READ_ANYTHING;
const showError = statusSummary.gateActive && CAN_READ_ANYTHING && loadError;
const showAdmin = statusSummary.gateActive && CAN_READ_ANYTHING && !loadError;
const gateStatusLabel = statusSummary.gateActive
  ? t("admin.security.gate_active_value")
  : t("admin.security.gate_inactive_value");
---

<AdminLayout title={t("admin.layout.nav_security")}>
  <h1>{t("admin.security.heading")}</h1>

  {
    !statusSummary.gateActive && (
      <StateNotice
        kind="info"
        title={t("admin.security.gate_disabled_title")}
        body={t("admin.security.gate_disabled_body")}
      />
    )
  }

  {
    showDenied && (
      <StateNotice
        kind="denied"
        title={t("admin.security.access_denied_title")}
        body={t("admin.security.access_denied_body")}
      />
    )
  }

  {showError && <LoadErrorNotice />}

  {
    showAdmin && (
      <div class="security-admin">
        <ActionBanner />
        <ClientJsonData data={clientStrings} />

        <section class="sec-section" aria-labelledby="status-legend">
          <h2 id="status-legend">{t("admin.security.status_legend")}</h2>
          <dl class="status-grid">
            <dt>{t("admin.security.gate_label")}</dt>
            <dd>
              <span class="status-pill" data-status={gateStatus}>
                {gateStatusLabel}
              </span>
            </dd>

            <dt>{t("admin.security.gate_profile_label")}</dt>
            <dd>
              <code>{statusSummary.gateProfile}</code>
            </dd>

            {statusRows.map((row) => (
              <Fragment>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </Fragment>
            ))}
          </dl>
        </section>

        {policy && CAN_READ_POLICY && (
          <section class="sec-section" aria-labelledby="policy-legend">
            <h2 id="policy-legend">{t("admin.security.policy_legend")}</h2>
            <form id="policy-form" class="sec-form">
              <fieldset disabled={!CAN_UPDATE_POLICY}>
                <CheckboxField
                  name="passwordLoginEnabled"
                  checked={policy.passwordLoginEnabled}
                  label={t("admin.security.password_login_enabled_label")}
                />
                <CheckboxField
                  name="ssoEnabled"
                  checked={policy.ssoEnabled}
                  label={t("admin.security.sso_enabled_label")}
                />
                <CheckboxField
                  name="ssoRequired"
                  checked={policy.ssoRequired}
                  label={t("admin.security.sso_required_label")}
                />
                <FieldHint variant="warning">{ssoRequiredHint}</FieldHint>

                <CheckboxField
                  name="autoLinkVerifiedEmail"
                  checked={policy.autoLinkVerifiedEmail}
                  label={t("admin.security.auto_link_verified_email_label")}
                />

                <TextField
                  name="allowedEmailDomains"
                  label={emailDomainsLabel}
                  value={policy.allowedEmailDomains.join(", ")}
                />
                <FieldHint>{emailDomainsHint}</FieldHint>

                <fieldset class="break-glass-fieldset">
                  <legend>{t("admin.security.break_glass_legend")}</legend>
                  <FieldHint>{t("admin.security.break_glass_hint")}</FieldHint>
                  {CAN_READ_USERS ? (
                    <CheckboxGroup
                      name="breakGlassIdentityIds"
                      items={buildBreakGlassItems(
                        breakGlassCandidates,
                        policy.breakGlassIdentityIds
                      )}
                    />
                  ) : (
                    <Fragment>
                      <TextField
                        name="breakGlassIdentityIdsManual"
                        label={t("admin.security.break_glass_manual_label")}
                        value={policy.breakGlassIdentityIds.join(", ")}
                      />
                      <FieldHint>{breakGlassManualHint}</FieldHint>
                    </Fragment>
                  )}
                </fieldset>

                {CAN_UPDATE_POLICY && (
                  <button type="submit" id="policy-save-button">
                    {t("admin.security.policy_save_button")}
                  </button>
                )}
              </fieldset>
            </form>
          </section>
        )}

        {CAN_READ_PROVIDERS && (
          <section class="sec-section" aria-labelledby="providers-legend">
            <h2 id="providers-legend">
              {t("admin.security.providers_legend")}
            </h2>

            <DataTable
              caption={t("admin.security.providers_legend")}
              columns={[
                t("admin.security.providers_table_key_column"),
                t("admin.security.providers_table_name_column"),
                t("admin.security.providers_table_issuer_column"),
                t("admin.security.providers_table_secret_column"),
                t("admin.security.providers_table_scopes_column"),
                t("admin.security.providers_table_domains_column"),
                t("admin.security.providers_table_status_column"),
                ...(CAN_UPDATE_PROVIDERS || CAN_DELETE_PROVIDERS
                  ? [t("admin.security.providers_table_actions_column")]
                  : [])
              ]}
              isEmpty={providers.length === 0}
              emptyMessage={t("admin.security.no_providers")}
            >
              {providers.map((provider) => (
                <tr data-provider-row={provider.id}>
                  <td>
                    <code>{provider.providerKey}</code>
                  </td>
                  <td>{provider.displayName}</td>
                  <td>{provider.issuerUrl}</td>
                  <td>
                    {provider.secretSource === "encrypted"
                      ? t("admin.security.secret_source_encrypted_value")
                      : t("admin.security.secret_source_env_value", {
                          name: provider.clientSecretEnvVar ?? ""
                        })}
                  </td>
                  <td>{provider.scopes}</td>
                  <td>{provider.allowedEmailDomains.join(", ")}</td>
                  <td>
                    <span
                      class="status-pill"
                      data-status={provider.enabled ? "active" : "inactive"}
                    >
                      {provider.enabled
                        ? t("admin.security.provider_enabled_value")
                        : t("admin.security.provider_disabled_value")}
                    </span>
                  </td>
                  {(CAN_UPDATE_PROVIDERS || CAN_DELETE_PROVIDERS) && (
                    <td class="sec-actions-cell">
                      {CAN_UPDATE_PROVIDERS && (
                        <details>
                          <summary>
                            {t("admin.security.edit_provider_summary")}
                          </summary>
                          <form
                            class="edit-provider-form sec-form"
                            data-provider-id={provider.id}
                          >
                            <TextField
                              name="displayName"
                              label={displayNameLabel}
                              value={provider.displayName}
                              required
                            />
                            <TextField
                              type="url"
                              name="issuerUrl"
                              label={issuerUrlLabel}
                              value={provider.issuerUrl}
                              required
                            />
                            <TextField
                              name="clientId"
                              label={clientIdLabel}
                              value={provider.clientId}
                              required
                            />
                            <TextField
                              type="password"
                              name="clientSecret"
                              label={clientSecretLabel}
                              autocomplete="new-password"
                            />
                            <TextField
                              name="clientSecretEnvVar"
                              label={clientSecretEnvVarLabel}
                            />
                            <FieldHint>{clientSecretHint}</FieldHint>
                            <TextField
                              name="scopes"
                              label={scopesLabel}
                              value={provider.scopes}
                              required
                            />
                            <TextField
                              name="allowedEmailDomains"
                              label={emailDomainsLabel}
                              value={provider.allowedEmailDomains.join(", ")}
                            />
                            <CheckboxField
                              name="enabled"
                              checked={provider.enabled}
                              label={providerEnabledLabel}
                            />
                            <button type="submit">
                              {t("admin.security.update_provider_submit")}
                            </button>
                          </form>
                        </details>
                      )}
                      {CAN_DELETE_PROVIDERS && (
                        <button
                          type="button"
                          class="delete-provider-button"
                          data-delete-provider={provider.id}
                        >
                          {t("admin.security.delete_provider_button")}
                        </button>
                      )}
                    </td>
                  )}
                </tr>
              ))}
            </DataTable>

            {CAN_CREATE_PROVIDERS && (
              <details class="sec-create">
                <summary>{t("admin.security.create_provider_summary")}</summary>
                <form id="create-provider-form" class="sec-form">
                  <TextField
                    name="providerKey"
                    label={t("admin.security.provider_key_label")}
                    pattern="^[a-z0-9][a-z0-9_-]*$"
                    required
                  />
                  <FieldHint>{t("admin.security.provider_key_hint")}</FieldHint>
                  <TextField
                    name="displayName"
                    label={displayNameLabel}
                    required
                  />
                  <TextField
                    type="url"
                    name="issuerUrl"
                    label={issuerUrlLabel}
                    required
                  />
                  <TextField name="clientId" label={clientIdLabel} required />
                  <TextField
                    type="password"
                    name="clientSecret"
                    label={clientSecretLabel}
                    autocomplete="new-password"
                  />
                  <TextField
                    name="clientSecretEnvVar"
                    label={clientSecretEnvVarLabel}
                  />
                  <FieldHint>{clientSecretEnvVarHint}</FieldHint>
                  <TextField
                    name="scopes"
                    label={scopesLabel}
                    value="openid email profile"
                    required
                  />
                  <TextField
                    name="allowedEmailDomains"
                    label={emailDomainsLabel}
                  />
                  <CheckboxField name="enabled" label={providerEnabledLabel} />
                  <button type="submit">
                    {t("admin.security.create_provider_submit")}
                  </button>
                </form>
              </details>
            )}
          </section>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  import { initSecurityAdmin } from "../../modules/identity-access/presentation/security-admin-client";

  initSecurityAdmin();
</script>
