---
/**
 * Access & Users admin screen — tenant users, roles, and role assignment.
 *
 * This file is markup. Its three other concerns live in the module's
 * presentation layer (ADR-0038), where `tsc` and `bun test` reach them
 * (Issue #372) and where their rationale is documented:
 *   - SSR data + permission gating -> `presentation/access-users-page-data.ts`
 *   - browser behaviour            -> `presentation/access-users-admin-client.ts`
 *   - styling                      -> `presentation/access-users-page.css`
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import ActionBanner from "../../components/ui/ActionBanner.astro";
import CheckboxGroup from "../../components/ui/CheckboxGroup.astro";
import ClientJsonData from "../../components/ui/ClientJsonData.astro";
import ConfirmDialog from "../../components/ui/ConfirmDialog.astro";
import DataTable from "../../components/ui/DataTable.astro";
import FormField from "../../components/ui/FormField.astro";
import LoadErrorNotice from "../../components/ui/LoadErrorNotice.astro";
import StateNotice from "../../components/ui/StateNotice.astro";
import StatusBadge from "../../components/ui/StatusBadge.astro";
import { createTranslator } from "../../lib/i18n/translate";
import {
  buildAccessUsersClientStrings,
  buildPermissionCheckboxSections,
  loadAccessUsersPageModel
} from "../../modules/identity-access/presentation/access-users-page-data";
import "../../modules/identity-access/presentation/access-users-page.css";

const context = Astro.locals.ssrContext;

if (!context) {
  throw new Error(
    "admin/access-users.astro rendered without Astro.locals.ssrContext — src/middleware.ts should have redirected to /login before this page ever runs."
  );
}

const t = await createTranslator(Astro.locals.locale);
const clientStrings = buildAccessUsersClientStrings(t);
const permissionLegend = t("admin.access_users.permission_legend");
const systemRoleNote = t("admin.access_users.system_role_note");
const actionsColumn = t("admin.access_users.actions_column");

const {
  canReadUsers: CAN_READ_USERS,
  canCreateUsers: CAN_CREATE_USERS,
  canUpdateUsers: CAN_UPDATE_USERS,
  canReadRoles: CAN_READ_ROLES,
  canConfigureRoles: CAN_CONFIGURE_ROLES,
  canAssign: CAN_ASSIGN,
  hasAnyAccess,
  data,
  loadError,
  permissionGroups
} = await loadAccessUsersPageModel(context, {
  correlationId: Astro.locals.correlationId
});
---

<AdminLayout title={t("admin.layout.nav_access_users")}>
  {
    !hasAnyAccess && (
      <StateNotice
        kind="denied"
        title={t("admin.access_users.access_denied_title")}
        body={t("admin.access_users.access_denied_body")}
      />
    )
  }
  {hasAnyAccess && loadError && <LoadErrorNotice />}
  {
    data && (
      <div class="access-users">
        <ActionBanner />
        <ConfirmDialog id="au-confirm-dialog" />
        <ClientJsonData data={clientStrings} />

        {CAN_READ_USERS && (
          <section class="au-section">
            <div class="au-section-header">
              <h2>{t("admin.access_users.users_title")}</h2>
            </div>

            <DataTable
              caption={t("admin.access_users.users_title")}
              columns={[
                t("admin.access_users.name_column"),
                t("admin.access_users.login_column"),
                t("admin.access_users.status_column"),
                t("admin.access_users.role_column"),
                ...(CAN_UPDATE_USERS || CAN_ASSIGN ? [actionsColumn] : [])
              ]}
              isEmpty={data.users.length === 0}
              emptyMessage={t("admin.access_users.no_users")}
            >
              {data.users.map((user) => (
                <tr data-user-row={user.tenantUserId}>
                  <td>{user.displayName}</td>
                  <td>{user.loginIdentifier}</td>
                  <td>
                    <StatusBadge
                      variant={user.status === "active" ? "success" : "danger"}
                      label={
                        user.status === "active"
                          ? t("common.status_active")
                          : t("common.status_inactive")
                      }
                    />
                  </td>
                  <td>
                    <div class="role-chip-list">
                      {user.roles.length === 0 && (
                        <span class="role-chip-empty">
                          {t("admin.layout.no_role")}
                        </span>
                      )}
                      {user.roles.map((role) => (
                        <span class="role-chip">
                          {role.roleName}
                          {CAN_ASSIGN && (
                            <button
                              type="button"
                              class="role-chip-remove"
                              data-unassign-user={user.tenantUserId}
                              data-unassign-role={role.roleId}
                              aria-label={t(
                                "admin.access_users.unassign_role_aria_label",
                                { role: role.roleName }
                              )}
                            >
                              &times;
                            </button>
                          )}
                        </span>
                      ))}
                    </div>
                    {CAN_ASSIGN && (
                      <form
                        class="assign-role-form"
                        data-assign-user={user.tenantUserId}
                      >
                        <select
                          name="roleId"
                          required
                          aria-label={t(
                            "admin.access_users.assign_role_select_aria_label",
                            { user: user.displayName }
                          )}
                        >
                          <option value="">
                            {t("admin.access_users.assign_role_placeholder")}
                          </option>
                          {data.roles
                            .filter(
                              (role) =>
                                !user.roles.some(
                                  (r) => r.roleId === role.roleId
                                )
                            )
                            .map((role) => (
                              <option value={role.roleId}>
                                {role.roleName}
                              </option>
                            ))}
                        </select>
                        <button type="submit">
                          {t("admin.access_users.assign_button")}
                        </button>
                      </form>
                    )}
                  </td>
                  {(CAN_UPDATE_USERS || CAN_ASSIGN) && (
                    <td>
                      {CAN_UPDATE_USERS && (
                        <button
                          type="button"
                          class="toggle-status-button"
                          data-toggle-user={user.tenantUserId}
                          data-next-status={
                            user.status === "active" ? "inactive" : "active"
                          }
                        >
                          {user.status === "active"
                            ? t("admin.access_users.deactivate_button")
                            : t("admin.access_users.activate_button")}
                        </button>
                      )}
                    </td>
                  )}
                </tr>
              ))}
            </DataTable>

            {CAN_CREATE_USERS && (
              <details class="au-create">
                <summary>{t("admin.access_users.create_user_summary")}</summary>
                <form id="create-user-form" class="au-form">
                  <FormField
                    id="create-user-display-name"
                    label={t("admin.access_users.name_label")}
                    required
                  >
                    <input
                      id="create-user-display-name"
                      type="text"
                      name="displayName"
                      required
                    />
                  </FormField>
                  <FormField
                    id="create-user-login-identifier"
                    label={t("admin.access_users.login_identifier_label")}
                    required
                  >
                    <input
                      id="create-user-login-identifier"
                      type="text"
                      name="loginIdentifier"
                      required
                    />
                  </FormField>
                  <FormField
                    id="create-user-password"
                    label={t("admin.access_users.password_label")}
                    required
                  >
                    <input
                      id="create-user-password"
                      type="password"
                      name="password"
                      minlength="8"
                      required
                    />
                  </FormField>
                  <CheckboxGroup
                    name="roleIds"
                    legend={t("admin.access_users.initial_roles_legend")}
                    items={data.roles.map((role) => ({
                      value: role.roleId,
                      label: role.roleName
                    }))}
                  />
                  <button type="submit">
                    {t("admin.access_users.create_user_submit")}
                  </button>
                </form>
              </details>
            )}
          </section>
        )}

        {CAN_READ_ROLES && (
          <section class="au-section">
            <div class="au-section-header">
              <h2>{t("admin.access_users.roles_title")}</h2>
            </div>

            <DataTable
              caption={t("admin.access_users.roles_title")}
              columns={[
                t("admin.access_users.role_column"),
                t("admin.access_users.code_column"),
                t("admin.access_users.permission_column"),
                t("admin.access_users.users_column"),
                ...(CAN_CONFIGURE_ROLES ? [actionsColumn] : [])
              ]}
              isEmpty={data.roles.length === 0}
              emptyMessage={t("admin.access_users.no_roles")}
            >
              {data.roles.map((role) => (
                <tr>
                  <td>
                    {role.roleName}
                    {role.isSystem && (
                      <em class="system-role-badge">
                        {t("admin.access_users.system_role_badge")}
                      </em>
                    )}
                  </td>
                  <td>
                    <code>{role.roleCode}</code>
                  </td>
                  <td>{role.permissionIds.length}</td>
                  <td>{role.assignedUserCount}</td>
                  {CAN_CONFIGURE_ROLES && (
                    <td>
                      <details>
                        <summary>
                          {t("admin.access_users.edit_summary")}
                        </summary>
                        <form
                          class="edit-role-form"
                          data-role-id={role.roleId}
                          data-role-system={role.isSystem ? "true" : "false"}
                        >
                          <FormField
                            id={`edit-role-name-${role.roleId}`}
                            label={t("admin.access_users.role_name_label")}
                            required
                          >
                            <input
                              id={`edit-role-name-${role.roleId}`}
                              type="text"
                              name="roleName"
                              value={role.roleName}
                              required
                            />
                          </FormField>
                          <CheckboxGroup
                            name="permissionIds"
                            disabled={role.isSystem}
                            legend={
                              role.isSystem
                                ? `${permissionLegend} ${systemRoleNote}`
                                : permissionLegend
                            }
                            groups={buildPermissionCheckboxSections(
                              permissionGroups,
                              role.permissionIds
                            )}
                          />
                          <button type="submit">
                            {t("admin.access_users.save_button")}
                          </button>
                        </form>
                      </details>
                      {!role.isSystem && (
                        <button
                          type="button"
                          class="delete-role-button"
                          data-delete-role={role.roleId}
                        >
                          {t("admin.access_users.delete_button")}
                        </button>
                      )}
                    </td>
                  )}
                </tr>
              ))}
            </DataTable>

            {CAN_CONFIGURE_ROLES && (
              <details class="au-create">
                <summary>{t("admin.access_users.create_role_summary")}</summary>
                <form id="create-role-form" class="au-form">
                  <FormField
                    id="create-role-code"
                    label={t("admin.access_users.role_code_label")}
                    hint={t("admin.access_users.role_code_placeholder")}
                    required
                  >
                    <input
                      id="create-role-code"
                      type="text"
                      name="roleCode"
                      pattern="^[a-z][a-z0-9_]*$"
                      placeholder={t(
                        "admin.access_users.role_code_placeholder"
                      )}
                      required
                    />
                  </FormField>
                  <FormField
                    id="create-role-name"
                    label={t("admin.access_users.role_name_label")}
                    required
                  >
                    <input
                      id="create-role-name"
                      type="text"
                      name="roleName"
                      required
                    />
                  </FormField>
                  <CheckboxGroup
                    name="permissionIds"
                    legend={permissionLegend}
                    groups={buildPermissionCheckboxSections(permissionGroups)}
                  />
                  <button type="submit">
                    {t("admin.access_users.create_role_submit")}
                  </button>
                </form>
              </details>
            )}
          </section>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  import { initAccessUsersAdmin } from "../../modules/identity-access/presentation/access-users-admin-client";

  initAccessUsersAdmin();
</script>
