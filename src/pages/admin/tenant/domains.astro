---
/**
 * Tenant domain/subdomain admin UI (Issue #563, epic #555) — built entirely
 * on top of the tenant domain management API (`/api/v1/tenant/domains/**`,
 * Issue #562).
 *
 * This file is markup. Its three other concerns live in the module's
 * presentation layer (ADR-0038), where `tsc` and `bun test` reach them
 * (Issue #372) and where their rationale is documented:
 *   - SSR read, permissions, option lists -> `presentation/tenant-domains-page-data.ts`
 *   - browser behaviour                   -> `presentation/tenant-domains-admin-client.ts`
 *   - styling                             -> `presentation/tenant-domains-page.css`
 *
 * Status badges use the real DB enum (`pending_verification | active |
 * suspended | failed`, migration 031) — not the issue's own shorthand list,
 * which has no fifth "verified" status distinct from `active` in this
 * schema.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ActionBanner from "../../../components/ui/ActionBanner.astro";
import CheckboxField from "../../../components/ui/CheckboxField.astro";
import ClientJsonData from "../../../components/ui/ClientJsonData.astro";
import ConfirmDialog from "../../../components/ui/ConfirmDialog.astro";
import DataTable from "../../../components/ui/DataTable.astro";
import FieldHint from "../../../components/ui/FieldHint.astro";
import LoadErrorNotice from "../../../components/ui/LoadErrorNotice.astro";
import SelectField from "../../../components/ui/SelectField.astro";
import StateNotice from "../../../components/ui/StateNotice.astro";
import StatusBadge from "../../../components/ui/StatusBadge.astro";
import { createTranslator } from "../../../lib/i18n/translate";
import { formatDateTime } from "../../../lib/i18n/format";
import {
  buildDomainStatusOptions,
  buildDomainTypeOptions,
  buildRouteModeOptions,
  buildTenantDomainClientStrings,
  buildVerificationMethodOptions,
  canPreviewNewsLink,
  canSetPrimaryDomain,
  canVerifyDomain,
  hasVerificationRecord,
  loadTenantDomainsPageModel,
  selectedStatusValue,
  statusBadgeVariant
} from "../../../modules/tenant-domain/presentation/tenant-domains-page-data";
import "../../../modules/tenant-domain/presentation/tenant-domains-page.css";

const context = Astro.locals.ssrContext;

if (!context) {
  throw new Error(
    "admin/tenant/domains.astro rendered without Astro.locals.ssrContext — src/middleware.ts should have redirected to /login before this page ever runs."
  );
}

const locale = Astro.locals.locale;
const t = await createTranslator(locale);
const clientStrings = buildTenantDomainClientStrings(t);

const {
  canRead: CAN_READ,
  canCreate: CAN_CREATE,
  canUpdate: CAN_UPDATE,
  canDelete: CAN_DELETE,
  canVerify: CAN_VERIFY,
  canSetPrimary: CAN_SET_PRIMARY,
  domains,
  loadError
} = await loadTenantDomainsPageModel(context, {
  correlationId: Astro.locals.correlationId
});

const domainTypeOptions = buildDomainTypeOptions(t);
const routeModeOptions = buildRouteModeOptions(t);
const statusOptions = buildDomainStatusOptions(t);
const verificationMethodOptions = buildVerificationMethodOptions(t);
const recordNameLabel = t("admin.tenant_domain.field_record_name");
const recordValueLabel = t("admin.tenant_domain.field_record_value");
const recordNameHeading = t("admin.tenant_domain.record_name_label");
const recordValueHeading = t("admin.tenant_domain.record_value_label");
const redirectLabel = t("admin.tenant_domain.field_redirect_to_primary");
const copyButtonLabel = t("admin.tenant_domain.copy_button");
---

<AdminLayout title={t("admin.tenant_domain.title")}>
  {
    !CAN_READ && (
      <StateNotice
        kind="denied"
        title={t("admin.tenant_domain.access_denied_title")}
        body={t("admin.tenant_domain.access_denied_body")}
      />
    )
  }
  {CAN_READ && loadError && <LoadErrorNotice />}
  {
    CAN_READ && !loadError && (
      <div class="domain-manager">
        <ActionBanner />
        <ConfirmDialog id="domain-confirm-dialog" />
        <ClientJsonData data={clientStrings} />

        <DataTable
          caption={t("admin.tenant_domain.title")}
          columns={[
            t("admin.tenant_domain.hostname_column"),
            t("admin.tenant_domain.type_column"),
            t("admin.tenant_domain.status_column"),
            t("admin.tenant_domain.verification_column"),
            t("admin.tenant_domain.actions_column")
          ]}
          isEmpty={domains.length === 0}
          emptyMessage={t("admin.tenant_domain.no_domains")}
        >
          {domains.map((domain) => (
            <tr>
              <td>
                <code>{domain.hostname}</code>
                {domain.isPrimary && (
                  <span
                    class="primary-badge"
                    title={t("admin.tenant_domain.primary_badge_label")}
                  >
                    <span aria-hidden="true">★</span>{" "}
                    {t("admin.tenant_domain.primary_badge_label")}
                  </span>
                )}
                <FieldHint as="div">
                  {formatDateTime(new Date(domain.createdAt), locale)}
                </FieldHint>
              </td>
              <td>
                {t(`admin.tenant_domain.domain_type.${domain.domainType}`)}
              </td>
              <td>
                <StatusBadge
                  variant={statusBadgeVariant(domain.status)}
                  label={t(`admin.tenant_domain.status.${domain.status}`)}
                />
              </td>
              <td>
                {domain.verificationMethod ? (
                  <div class="verification-cell">
                    <FieldHint as="span">
                      {t(
                        `admin.tenant_domain.verification_method.${domain.verificationMethod}`
                      )}
                    </FieldHint>
                    {hasVerificationRecord(domain) &&
                    domain.verificationRecordName &&
                    domain.verificationRecordValue ? (
                      <dl class="record-list">
                        <dt>{recordNameHeading}</dt>
                        <dd>
                          <code>{domain.verificationRecordName}</code>
                          <button
                            type="button"
                            class="copy-record-button"
                            data-copy-value={domain.verificationRecordName}
                          >
                            {copyButtonLabel}
                          </button>
                        </dd>
                        <dt>{recordValueHeading}</dt>
                        <dd>
                          <code>{domain.verificationRecordValue}</code>
                          <button
                            type="button"
                            class="copy-record-button"
                            data-copy-value={domain.verificationRecordValue}
                          >
                            {copyButtonLabel}
                          </button>
                        </dd>
                      </dl>
                    ) : (
                      hasVerificationRecord(domain) && (
                        <FieldHint>
                          {t("admin.tenant_domain.no_record_configured")}
                        </FieldHint>
                      )
                    )}
                  </div>
                ) : (
                  <FieldHint as="span">
                    {t("admin.tenant_domain.verification_method_none")}
                  </FieldHint>
                )}
              </td>
              <td class="actions-cell">
                {CAN_VERIFY && canVerifyDomain(domain) && (
                  <button
                    type="button"
                    class="verify-domain-button"
                    data-domain-id={domain.id}
                  >
                    {t("admin.tenant_domain.verify_button")}
                  </button>
                )}
                {CAN_SET_PRIMARY && canSetPrimaryDomain(domain) && (
                  <button
                    type="button"
                    class="set-primary-domain-button"
                    data-domain-id={domain.id}
                  >
                    {t("admin.tenant_domain.set_primary_button")}
                  </button>
                )}
                {canPreviewNewsLink(domain) && (
                  <a
                    class="preview-link"
                    href={`https://${domain.normalizedHostname}/news`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={t("admin.tenant_domain.preview_hint")}
                  >
                    {t("admin.tenant_domain.preview_link")}
                  </a>
                )}
                {CAN_UPDATE && (
                  <details class="edit-domain">
                    <summary>{t("admin.tenant_domain.edit_summary")}</summary>
                    <form class="edit-domain-form" data-domain-id={domain.id}>
                      <SelectField
                        layout="stacked"
                        name="domainType"
                        label={t("admin.tenant_domain.field_domain_type")}
                        options={domainTypeOptions}
                        selected={domain.domainType}
                      />
                      <SelectField
                        layout="stacked"
                        name="routeMode"
                        label={t("admin.tenant_domain.field_route_mode")}
                        options={routeModeOptions}
                        selected={domain.routeMode}
                      />
                      <SelectField
                        layout="stacked"
                        name="status"
                        label={t("admin.tenant_domain.field_status")}
                        options={statusOptions}
                        selected={selectedStatusValue(domain.status)}
                      />
                      {domain.status === "active" && (
                        <FieldHint as="span">
                          {t("admin.tenant_domain.field_status_active_hint")}
                        </FieldHint>
                      )}
                      <SelectField
                        layout="stacked"
                        name="verificationMethod"
                        label={t(
                          "admin.tenant_domain.field_verification_method"
                        )}
                        options={verificationMethodOptions}
                        selected={domain.verificationMethod ?? ""}
                      />
                      <label>
                        {recordNameLabel}
                        <input
                          type="text"
                          name="verificationRecordName"
                          maxlength="2000"
                          value={domain.verificationRecordName ?? ""}
                        />
                      </label>
                      <label>
                        {recordValueLabel}
                        <input
                          type="text"
                          name="verificationRecordValue"
                          maxlength="2000"
                          value={domain.verificationRecordValue ?? ""}
                        />
                      </label>
                      <CheckboxField
                        name="redirectToPrimary"
                        label={redirectLabel}
                        checked={domain.redirectToPrimary}
                      />
                      <button type="submit">
                        {t("admin.tenant_domain.save_button")}
                      </button>
                    </form>
                  </details>
                )}
                {CAN_DELETE && (
                  <button
                    type="button"
                    class="delete-domain-button"
                    data-domain-id={domain.id}
                  >
                    {t("admin.tenant_domain.delete_button")}
                  </button>
                )}
              </td>
            </tr>
          ))}
        </DataTable>

        {CAN_CREATE && (
          <details class="create-domain">
            <summary>{t("admin.tenant_domain.create_summary")}</summary>
            <form id="create-domain-form" class="create-domain-form">
              <label>
                {t("admin.tenant_domain.field_hostname")}
                <input
                  type="text"
                  name="hostname"
                  required
                  maxlength="253"
                  autocomplete="off"
                  spellcheck="false"
                />
                <FieldHint as="span">
                  {t("admin.tenant_domain.field_hostname_hint")}
                </FieldHint>
              </label>
              <SelectField
                layout="stacked"
                name="domainType"
                label={t("admin.tenant_domain.field_domain_type")}
                options={domainTypeOptions}
              />
              <SelectField
                layout="stacked"
                name="routeMode"
                label={t("admin.tenant_domain.field_route_mode")}
                options={routeModeOptions}
                selected="canonical"
              />
              <SelectField
                layout="stacked"
                name="verificationMethod"
                label={t("admin.tenant_domain.field_verification_method")}
                options={verificationMethodOptions}
              />
              <label>
                {recordNameLabel}
                <input
                  type="text"
                  name="verificationRecordName"
                  maxlength="2000"
                />
              </label>
              <label>
                {recordValueLabel}
                <input
                  type="text"
                  name="verificationRecordValue"
                  maxlength="2000"
                />
              </label>
              <CheckboxField name="redirectToPrimary" label={redirectLabel} />
              <button type="submit">
                {t("admin.tenant_domain.create_submit")}
              </button>
            </form>
          </details>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  import { initTenantDomainsAdmin } from "../../../modules/tenant-domain/presentation/tenant-domains-admin-client";

  initTenantDomainsAdmin();
</script>
