---
/**
 * Visitor analytics dashboard (Issue #622, epic #617-#624).
 *
 * This file is markup. Its three other concerns live in the module's
 * presentation layer (ADR-0038), where `tsc` and `bun test` reach them
 * (Issue #372) and where their rationale is documented:
 *   - permissions/config + option lists -> `presentation/analytics-page-data.ts`
 *   - browser behaviour                 -> `presentation/analytics-dashboard-client.ts`
 *   - styling                           -> `presentation/analytics-dashboard.css`
 *
 * Every number and table below is filled in by a client-side `fetch` to the
 * already-shipped `GET /api/v1/analytics/*` endpoints — this page adds no
 * endpoint, no permission, and never touches the database.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import ClientJsonData from "../../components/ui/ClientJsonData.astro";
import DataTable from "../../components/ui/DataTable.astro";
import SelectField from "../../components/ui/SelectField.astro";
import StateNotice from "../../components/ui/StateNotice.astro";
import { createTranslator } from "../../lib/i18n/translate";
import {
  buildAnalyticsClientStrings,
  buildRangeOptions,
  buildSessionAreaOptions,
  buildSessionTypeOptions,
  resolveAnalyticsPageModel
} from "../../modules/visitor-analytics/presentation/analytics-page-data";
import "../../modules/visitor-analytics/presentation/analytics-dashboard.css";

const context = Astro.locals.ssrContext;

if (!context) {
  throw new Error(
    "admin/analytics.astro rendered without Astro.locals.ssrContext — src/middleware.ts should have redirected to /login before this page ever runs."
  );
}

const locale = Astro.locals.locale;
const t = await createTranslator(locale);
const clientStrings = buildAnalyticsClientStrings(t);

const {
  canViewDashboard: CAN_VIEW_DASHBOARD,
  canViewRealtime: CAN_VIEW_REALTIME,
  canViewSessions: CAN_VIEW_SESSIONS,
  canViewRawDetail: CAN_VIEW_RAW_DETAIL,
  geoActive,
  pageConfig
} = resolveAnalyticsPageModel(context, locale);

const nameColumn = t("admin.analytics.devices_column_name");
const countColumn = t("admin.analytics.devices_column_count");
const stateLoading = t("admin.analytics.state_loading");
---

<AdminLayout title={t("admin.layout.nav_visitor_analytics")}>
  <h1>{t("admin.analytics.heading")}</h1>

  {
    !CAN_VIEW_DASHBOARD && (
      <StateNotice
        kind="denied"
        title={t("admin.analytics.access_denied_title")}
        body={t("admin.analytics.access_denied_body")}
      />
    )
  }

  {
    CAN_VIEW_DASHBOARD && (
      <div class="analytics-dashboard">
        <ClientJsonData data={clientStrings} />
        <ClientJsonData id="analytics-page-config" data={pageConfig} />

        {CAN_VIEW_REALTIME && (
          <section
            class="analytics-section"
            aria-labelledby="realtime-legend"
            data-section="realtime"
          >
            <div class="section-header">
              <h2 id="realtime-legend">
                {t("admin.analytics.online_heading")}
              </h2>
              <button
                type="button"
                id="realtime-refresh-button"
                class="ghost-button"
              >
                {t("admin.analytics.online_refresh_button")}
              </button>
            </div>
            <div class="stat-grid">
              <div class="stat-tile">
                <span class="stat-value" data-field="onlineHumanCount">
                  –
                </span>
                <span class="stat-label">
                  {t("admin.analytics.online_human_label")}
                </span>
              </div>
              <div class="stat-tile">
                <span class="stat-value" data-field="onlineAdminCount">
                  –
                </span>
                <span class="stat-label">
                  {t("admin.analytics.online_admin_label")}
                </span>
              </div>
              <div class="stat-tile">
                <span class="stat-value" data-field="onlinePublicCount">
                  –
                </span>
                <span class="stat-label">
                  {t("admin.analytics.online_public_label")}
                </span>
              </div>
              <div class="stat-tile">
                <span class="stat-value" data-field="onlineApiCount">
                  –
                </span>
                <span class="stat-label">
                  {t("admin.analytics.online_api_label")}
                </span>
              </div>
            </div>
            <p class="section-hint" data-role="realtime-updated-at" />
            <p
              class="section-state"
              data-role="realtime-state"
              aria-live="polite"
            >
              {stateLoading}
            </p>
          </section>
        )}

        <section
          class="analytics-section"
          aria-labelledby="summary-legend"
          data-section="summary"
        >
          <h2 id="summary-legend">{t("admin.analytics.summary_heading")}</h2>
          <div class="stat-grid">
            {[
              { range: "24h", label: t("admin.analytics.summary_24h_label") },
              { range: "7d", label: t("admin.analytics.summary_7d_label") },
              { range: "30d", label: t("admin.analytics.summary_30d_label") }
            ].map(({ range, label }) => (
              <div class="stat-tile" data-summary-range={range}>
                <span class="stat-value" data-field="humanUniqueVisitors">
                  –
                </span>
                <span class="stat-label">{label}</span>
                <span class="stat-sub">
                  <span data-field="humanPageviews">–</span>{" "}
                  {t("admin.analytics.summary_pageviews_label")}
                </span>
              </div>
            ))}
          </div>
          <p class="section-state" data-role="summary-state" aria-live="polite">
            {stateLoading}
          </p>
        </section>

        <div class="analytics-toolbar">
          <SelectField
            id="range-select"
            name="range"
            label={t("admin.analytics.range_filter_label")}
            options={buildRangeOptions(t)}
            selected="7d"
          />
        </div>

        <section
          class="analytics-section"
          aria-labelledby="pages-legend"
          data-section="pages"
        >
          <h2 id="pages-legend">{t("admin.analytics.pages_heading")}</h2>
          <DataTable
            caption={t("admin.analytics.pages_heading")}
            dataRole="pages-table"
            columns={[
              t("admin.analytics.pages_column_path"),
              t("admin.analytics.pages_column_views")
            ]}
          />
          <p class="section-state" data-role="pages-state" aria-live="polite">
            {stateLoading}
          </p>
        </section>

        <section
          class="analytics-section"
          aria-labelledby="devices-legend"
          data-section="devices"
        >
          <h2 id="devices-legend">{t("admin.analytics.devices_heading")}</h2>
          <div class="devices-grid">
            <div>
              <h3>{t("admin.analytics.devices_browsers_subheading")}</h3>
              <DataTable
                caption={t("admin.analytics.devices_browsers_subheading")}
                dataRole="browsers-table"
                columns={[nameColumn, countColumn]}
              />
            </div>
            <div>
              <h3>{t("admin.analytics.devices_devices_subheading")}</h3>
              <DataTable
                caption={t("admin.analytics.devices_devices_subheading")}
                dataRole="devices-table"
                columns={[nameColumn, countColumn]}
              />
            </div>
          </div>
          <p class="section-state" data-role="devices-state" aria-live="polite">
            {stateLoading}
          </p>
        </section>

        {geoActive ? (
          <section
            class="analytics-section"
            aria-labelledby="locations-legend"
            data-section="locations"
          >
            <h2 id="locations-legend">
              {t("admin.analytics.locations_heading")}
            </h2>
            <DataTable
              caption={t("admin.analytics.locations_heading")}
              dataRole="locations-table"
              columns={[
                t("admin.analytics.locations_column_country"),
                t("admin.analytics.locations_column_count")
              ]}
            />
            <p
              class="section-state"
              data-role="locations-state"
              aria-live="polite"
            >
              {stateLoading}
            </p>
          </section>
        ) : (
          <section class="analytics-section" aria-labelledby="locations-legend">
            <h2 id="locations-legend">
              {t("admin.analytics.locations_heading")}
            </h2>
            <StateNotice
              kind="info"
              title={t("admin.analytics.locations_disabled_title")}
              body={t("admin.analytics.locations_disabled_body")}
            />
          </section>
        )}

        <section
          class="analytics-section"
          aria-labelledby="security-legend"
          data-section="security"
        >
          <h2 id="security-legend">{t("admin.analytics.security_heading")}</h2>
          <div class="stat-grid stat-grid-single">
            <div class="stat-tile">
              <span class="stat-value" data-field="botPageviews">
                –
              </span>
              <span class="stat-label">
                {t("admin.analytics.security_total_label")}
              </span>
            </div>
          </div>
          <div class="devices-grid">
            <div>
              <h3>{t("admin.analytics.security_by_reason_heading")}</h3>
              <DataTable
                caption={t("admin.analytics.security_by_reason_heading")}
                dataRole="bot-reasons-table"
                columns={[nameColumn, countColumn]}
              />
            </div>
            <div>
              <h3>{t("admin.analytics.security_by_area_heading")}</h3>
              <DataTable
                caption={t("admin.analytics.security_by_area_heading")}
                dataRole="bot-areas-table"
                columns={[nameColumn, countColumn]}
              />
            </div>
          </div>
          <p
            class="section-state"
            data-role="security-state"
            aria-live="polite"
          >
            {stateLoading}
          </p>
        </section>

        {CAN_VIEW_SESSIONS && (
          <section
            class="analytics-section"
            aria-labelledby="sessions-legend"
            data-section="sessions"
          >
            <h2 id="sessions-legend">
              {t("admin.analytics.sessions_heading")}
            </h2>
            <div class="analytics-toolbar">
              <SelectField
                id="sessions-area-filter"
                name="area"
                label={t("admin.analytics.sessions_area_filter_label")}
                options={buildSessionAreaOptions(t)}
                selected="all"
              />
              <SelectField
                id="sessions-type-filter"
                name="visitorType"
                label={t("admin.analytics.sessions_type_filter_label")}
                options={buildSessionTypeOptions(t)}
                selected="all"
              />
            </div>
            <DataTable
              caption={t("admin.analytics.sessions_heading")}
              dataRole="sessions-table"
              columns={[
                t("admin.analytics.sessions_column_area"),
                t("admin.analytics.sessions_column_path"),
                t("admin.analytics.sessions_column_browser"),
                t("admin.analytics.sessions_column_os"),
                t("admin.analytics.sessions_column_device"),
                t("admin.analytics.sessions_column_type"),
                t("admin.analytics.sessions_column_country"),
                t("admin.analytics.sessions_column_last_seen"),
                ...(CAN_VIEW_RAW_DETAIL
                  ? [
                      t("admin.analytics.sessions_column_ip"),
                      t("admin.analytics.sessions_column_ip_hash"),
                      t("admin.analytics.sessions_column_user_agent_hash"),
                      t("admin.analytics.sessions_column_login_identifier")
                    ]
                  : [])
              ]}
            />
            <p
              class="section-state"
              data-role="sessions-state"
              aria-live="polite"
            >
              {stateLoading}
            </p>
            <button
              type="button"
              id="sessions-load-more-button"
              class="ghost-button"
              hidden
            >
              {t("admin.analytics.sessions_load_more_button")}
            </button>
          </section>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  import { initAnalyticsDashboard } from "../../modules/visitor-analytics/presentation/analytics-dashboard-client";

  initAnalyticsDashboard();
</script>
