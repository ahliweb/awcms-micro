# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Local dev-only Docker Compose overrides (Issue #682) — auto-loaded by
# `docker compose`, never committed (each operator's own local port/volume
# preferences, not shared config). See docker-compose.override.yml.example.
docker-compose.override.yml

# PgBouncer SCRAM verifier file (Issue #682) — contains SCRAM-SHA-256
# verifiers (equivalent to password hashes; usable for offline dictionary
# attacks against DB roles), never committed. See
# deploy/pgbouncer/pgbouncer.ini.example's header for how to generate it.
userlist.txt

# Build output
dist/
.astro/
build/

# Local storage & backups
storage/
*.dump
*.sql.gz

# Local runtime artifacts (e.g. REPORTING_EXPORT_ROOT_PATH default output)
/var/

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Playwright E2E artifacts
playwright-report/
test-results/
blob-report/

# Claude Code user-local settings (jangan commit)
.claude/settings.local.json
# Agent worktrees — full checkouts of this repo at another commit, created by
# parallel agent runs. Never part of the tree; see scripts/cleanup-agent-worktrees.sh
# (they can outlive the agent when a container writes root-owned files into them).
.claude/worktrees/

# graphify incremental-extraction cache — machine-local, regenerable, large.
# The graph outputs (graph.json/GRAPH_REPORT.md/manifest.json/GRAPH_TREE.html)
# are committed; the cache under graphify-out/cache/ is not.
graphify-out/cache/
# graphify dated backups of the prior curated graph (graphify-out/YYYY-MM-DD/)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Penanda lokal per-mesin (absolute path checkout + interpreter uv), bukan hasil.
graphify-out/.graphify_root
graphify-out/.graphify_python
